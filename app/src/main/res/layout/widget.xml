<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <!-- 三个开关行，均分上半区高度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical">

        <!-- 开发者模式（总开关） -->
        <LinearLayout
            android:id="@+id/devArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivDevSwitch"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:src="@drawable/switch_off"
                android:contentDescription="developer mode toggle" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="开发者"
                android:textColor="#ECEFF1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="关闭"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- USB 调试 -->
        <LinearLayout
            android:id="@+id/usbArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivUsbSwitch"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:src="@drawable/switch_off"
                android:contentDescription="usb debugging toggle" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="USB调试"
                android:textColor="#ECEFF1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsbState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="关闭"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 无线调试 -->
        <LinearLayout
            android:id="@+id/wifiArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivWifiSwitch"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:src="@drawable/switch_off"
                android:contentDescription="wireless adb toggle" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="无线调试"
                android:textColor="#ECEFF1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWifiState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="关闭"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- 分隔线：FrameLayout 代替 View（RemoteViews 白名单） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="#40FFFFFF" />

    <!-- 信息区：整块可点刷新；4 行均分下半区高度 -->
    <LinearLayout
        android:id="@+id/infoArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="守护"
                android:textColor="#90A4AE"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDaemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="--"
                android:textColor="#FFB74D"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="IP"
                android:textColor="#90A4AE"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="端口"
                android:textColor="#90A4AE"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="WiFi"
                android:textColor="#90A4AE"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvSsid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
